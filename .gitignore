# =========================
# OS / Editor / IDE
# =========================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

.idea/
# VSCode: ignore folder contents but keep shared config files in version control.
# Use ".vscode/*" (not ".vscode/") because Git does not re-include files whose
# parent directory has been excluded; the wildcard keeps the directory itself
# visible so the `!file` overrides below actually take effect.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
*.swp
*.swo
*~
*.iml
*.code-workspace

# =========================
# Environment / Secrets
# =========================
.env
.env.*
!.env.example
!.env.*.example
*.local
*.secret
*.secret.*
secrets/
**/secrets/

# Certificates / keys / keystores (never commit private material)
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
*.jks
*.keystore

# =========================
# Logs / Runtime files
# =========================
logs/
log/
*.log
*.log.*
*.pid
*.seed
*.tmp
tmp/
temp/

# =========================
# Go / Kratos backend
# =========================
# Build outputs
/bin/
/build/
/dist/
/out/
/release/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.test.exe
*.prof
*.pprof
*.stack
*.cover
coverage.out
coverage.html
coverage.txt
**/coverage.out
**/coverage.html
**/coverage.txt

# Go workspace/cache generated locally
go.work
go.work.sum
.gocache/
.gomodcache/
.golangci-cache/
.cache/

# Dependency vendoring is usually generated; remove this if you commit vendor/
# vendor/

# Kratos service local configs; keep templates/examples in git.
# Single glob covers backend/, consumer/, driver/, manager/ service trees.
**/configs/*.local.*
**/configs/*local*

# Kratos / microservice generated runtime artifacts
*.pb.tmp
*.swagger.tmp
*.swagger.json
openapi.swagger.json
openapi-*.json

# kratos run / kratos run dev leftovers
kratos-run.log

# Debugger files
.dlv/
*.debug

